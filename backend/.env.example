# Окружение агента. Скопируйте в .env рядом с docker-compose.yml и заполните.
#
# Кейс допускает только модели из каталога Cloud.ru. Адрес модели проверяется
# по списку при старте: чужой адрес — сервис не запустится и скажет почему.
# Выключателя этой проверки нет.

# --- Модель (обязательно) ---------------------------------------------------
# На площадке хакатона значения лежат в /opt/hackathon/ai.env —
# `make deploy` переносит их сам, вручную заполнять не нужно.
LLM_PROFILE=hackathon
LLM_AUTH_SCHEME=Bearer
WEB_PORT=8000
OPENAI_BASE_URL=https://hub.gigaschool.ru/api/v1/llm/v1
OPENAI_API_KEY=
OPENAI_MODEL=GigaChat/GigaChat-3-Pro

# Без ключа и модели сервис работает на офлайн-заглушке: структура и часы
# настоящие, содержание — болванки. Это видно в /api/health и в интерфейсе.

# --- Доступ к статистике ----------------------------------------------------
# В телеметрии тексты запросов методистов и стоимость генераций.
# Без токена раздел закрыт целиком. Сгенерировать:
#   python3 -c "import secrets; print(secrets.token_urlsafe(18))"
METRICS_TOKEN=

# --- Экономика для защиты (руб. за 1000 токенов) ----------------------------
# Цены GigaChat-3-Pro на шлюзе площадки; поменяйте под свою модель.
PRICE_PROMPT_PER_1K=0.07303
PRICE_COMPLETION_PER_1K=0.17639
METHODIST_HOUR_COST=800
MANUAL_HOURS_PER_PROGRAM=60

# Для тестового VPS используйте .env.yandex.example; профиль yandex_dev.
# LLM_EXTRA_HOSTS не расширяет разрешённые профилем адреса.
