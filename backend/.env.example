# Провайдер LLM: mock (офлайн-демо) | openai_compat
LLM_PROVIDER=openai_compat

# --- Yandex Foundation Models (только локальная разработка) ---
# Адрес вне списка разрешённых, поэтому нужен явный LLM_ALLOW_ANY_HOST=1.
# В сдаче и на защите этот флаг не ставится: кейс допускает только Cloud.ru.
LLM_ALLOW_ANY_HOST=1
LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
LLM_API_KEY=<api-key>
LLM_MODEL=gpt://<folder-id>/yandexgpt/latest
LLM_AUTH_SCHEME=Api-Key

# --- Cloud.ru Evolution Foundation Models (финальная сдача) ---
# Разрешённые хосты зашиты в config.py: *.cloud.ru, hub.gigaschool.ru
# OPENAI_BASE_URL=https://foundation-models.api.cloud.ru/v1
# LLM_API_KEY=<token>
# LLM_MODEL=GigaChat-Max
# LLM_AUTH_SCHEME=Bearer

# Экономика генерации (руб. за 1000 токенов) — для расчёта эффекта на защите
PRICE_PROMPT_PER_1K=0.20
PRICE_COMPLETION_PER_1K=0.60
METHODIST_HOUR_COST=800
MANUAL_HOURS_PER_PROGRAM=60
