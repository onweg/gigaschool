# Образец для /opt/gigaschool/.env на тестовом VPS.
# Существующий ключ и METRICS_TOKEN сохраните; значения ниже не секреты.
LLM_PROFILE=yandex_dev
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
LLM_API_KEY=
LLM_MODEL=gpt://<folder-id>/yandexgpt/latest
LLM_AUTH_SCHEME=Api-Key
WEB_PORT=3100
METRICS_TOKEN=
PRICE_PROMPT_PER_1K=0.20
PRICE_COMPLETION_PER_1K=0.60
METHODIST_HOUR_COST=800
MANUAL_HOURS_PER_PROGRAM=60
# LLM_EXTRA_HOSTS не нужен: адрес Yandex уже разрешён этим профилем.
# OPENAI_* здесь не нужны. В интерфейсе нет добавления или выбора других моделей.
